<Window x:Class="CIPHER.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CIPHER"
        Width="780"
        Height="560"
        MinWidth="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        Loaded="Window_Loaded">
    <Border CornerRadius="26"
            Background="#E6101826"
            BorderBrush="#3B82F6"
            BorderThickness="1"
            Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.45" Color="#2563EB" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBorder"
                    Grid.Row="0"
                    Background="Transparent"
                    MouseLeftButtonDown="HeaderBorder_MouseLeftButtonDown"
                    Padding="2,0,2,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0"
                             Width="15"
                             Height="15"
                             Margin="2,0,10,0"
                             VerticalAlignment="Center"
                             Fill="{Binding StatusBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="CIPHER"
                                   Foreground="#F8FAFC"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="#93C5FD"
                                   FontSize="12" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="⚙"
                            ToolTip="Settings"
                            Command="{Binding ToggleSettingsCommand}"
                            Width="34"
                            Height="30"
                            Margin="4,0"
                            Background="#1E293B"
                            Foreground="#E2E8F0"
                            BorderBrush="#334155" />
                    <Button Grid.Column="3"
                            Content="—"
                            ToolTip="Collapse or expand"
                            Command="{Binding ToggleExpandedCommand}"
                            Width="34"
                            Height="30"
                            Margin="4,0"
                            Background="#1E293B"
                            Foreground="#E2E8F0"
                            BorderBrush="#334155" />
                    <Button Grid.Column="4"
                            Content="✕"
                            ToolTip="Close CIPHER"
                            Click="CloseButton_Click"
                            Width="34"
                            Height="30"
                            Margin="4,0"
                            Background="#1E293B"
                            Foreground="#E2E8F0"
                            BorderBrush="#334155" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0"
                         ItemsSource="{Binding Conversation}"
                         Background="#0B1220"
                         BorderBrush="#1E3A5F"
                         BorderThickness="1"
                         Foreground="#E2E8F0"
                         Padding="8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       TextWrapping="Wrap"
                                       Margin="2,3" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1"
                            Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Margin="0,10,0,0"
                            Background="#0F1E33">
                    <TextBlock Text="Settings"
                               Foreground="#F8FAFC"
                               FontWeight="SemiBold"
                               Margin="10,8,10,4" />
                    <CheckBox Content="Keep CIPHER always on top"
                              IsChecked="{Binding AlwaysOnTop}"
                              Foreground="#E2E8F0"
                              Margin="10,4" />
                    <Grid Margin="10,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Wake phrase"
                                   Foreground="#CBD5E1"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding WakePhrase, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#020617"
                                 Foreground="#F8FAFC"
                                 BorderBrush="#334155"
                                 Padding="6,4" />
                    </Grid>
                    <TextBlock Text="High-risk and destructive actions always require explicit confirmation."
                               Foreground="#FACC15"
                               Margin="10,4"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Global hotkey: Ctrl+Alt+C shows or hides CIPHER. The tray icon also restores or exits CIPHER."
                               Foreground="#CBD5E1"
                               Margin="10,4"
                               TextWrapping="Wrap" />
                    <Button Content="Save settings"
                            Command="{Binding SaveSettingsCommand}"
                            HorizontalAlignment="Left"
                            Margin="10,6,10,10"
                            Padding="12,5"
                            Background="#1D4ED8"
                            Foreground="White"
                            BorderBrush="#3B82F6" />
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="CommandInput"
                             Grid.Column="0"
                             AutomationProperties.Name="CIPHER command input"
                             Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="CommandInput_KeyDown"
                             Background="#020617"
                             Foreground="#F8FAFC"
                             BorderBrush="#334155"
                             Padding="10,7"
                             FontSize="14" />
                    <Button Grid.Column="1"
                            Content="Send"
                            Command="{Binding ExecuteCommand}"
                            Margin="8,0,0,0"
                            Padding="14,7"
                            Background="#2563EB"
                            Foreground="White"
                            BorderBrush="#60A5FA" />
                    <Button Grid.Column="2"
                            Content="🎙"
                            ToolTip="Voice input status"
                            Command="{Binding VoiceCommand}"
                            Margin="8,0,0,0"
                            Padding="11,7"
                            Background="#1E293B"
                            Foreground="#E2E8F0"
                            BorderBrush="#334155" />
                    <Button Grid.Column="3"
                            Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Margin="8,0,0,0"
                            Padding="12,7"
                            Background="#7F1D1D"
                            Foreground="White"
                            BorderBrush="#EF4444" />
                    <Button Grid.Column="4"
                            Content="Clear"
                            Command="{Binding ClearCommand}"
                            Margin="8,0,0,0"
                            Padding="12,7"
                            Background="#1E293B"
                            Foreground="#E2E8F0"
                            BorderBrush="#334155" />
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 Height="6"
                                 Background="#1E293B"
                                 Foreground="#38BDF8" />
                    <TextBlock Text="{Binding ProgressText}"
                               Foreground="#CBD5E1"
                               FontSize="12"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
