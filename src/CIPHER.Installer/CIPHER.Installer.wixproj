<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>CIPHER</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- package.bat publishes the app here and stages offline payloads under
         dependencies\ before building this project. -->
    <PublishDir>..\..\artifacts\publish\win-x64</PublishDir>
    <DepsDir>..\..\dependencies</DepsDir>
    <DefineConstants>PublishDir=$(PublishDir);DepsDir=$(DepsDir)</DefineConstants>
    <!-- Per-user packages built from harvested file components (WiX <Files>)
         trip two ICEs by design: ICE38 (file KeyPaths instead of HKCU registry
         KeyPaths) and ICE64 (generated directories without RemoveFile rows).
         Both are standard suppressions for per-user installs; correctness is
         verified functionally in CI (MSI builds, payload extraction matches,
         install → shortcut → uninstall leaves nothing behind). -->
    <SuppressIces>ICE38;ICE64</SuppressIces>
  </PropertyGroup>
</Project>
