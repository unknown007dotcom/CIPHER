<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>CIPHER</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- package.bat publishes the app here and stages offline payloads under
         dependencies\ before building this project. -->
    <PublishDir>..\..\artifacts\publish\win-x64</PublishDir>
    <DepsDir>..\..\dependencies</DepsDir>
    <DefineConstants>PublishDir=$(PublishDir);DepsDir=$(DepsDir)</DefineConstants>
    <!-- Harvested file components (WiX <Files>) do not emit RemoveFile rows for
         their generated directories, which ICE64 flags for per-user packages.
         Directory cleanup on uninstall is verified functionally in CI
         (install → verify → uninstall), so this ICE is suppressed deliberately. -->
    <SuppressIces>ICE64</SuppressIces>
  </PropertyGroup>
</Project>
